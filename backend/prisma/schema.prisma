generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgTier {
  FREE
  PREMIUM
}

model Organization {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  tier              OrgTier   @default(FREE)
  razorpayCustomerId String?  @unique
  razorpaySubscriptionId String? @unique
  subscriptionStatus String?  // active, cancelled, past_due, etc.
  currentPeriodEnd   DateTime?
  // Cancelled by the customer but paid up until currentPeriodEnd.
  cancelAtPeriodEnd  Boolean   @default(false)
  // Razorpay created_at of the newest billing event applied. An event older
  // than this arrived out of order and must not overwrite newer state.
  billingEventAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  forms     Form[]
  webhooks  Webhook[]
  responses Response[]
  webhookDeadLetters WebhookDeadLetter[]
  billingEvents      BillingEvent[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  name         String?
  role         OrgRole  @default(MEMBER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  forms        Form[]       @relation("UserForms")

  @@unique([orgId, email])
  @@index([orgId])
}

model Form {
  id              String   @id @default(cuid())
  orgId           String
  createdById     String
  name            String
  schema          Json
  thankYouMessage String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("UserForms", fields: [createdById], references: [id])
  webhooks     Webhook[]
  responses    Response[]
  webhookDeadLetters WebhookDeadLetter[]

  @@index([orgId])
  @@index([createdById])
}

model Webhook {
  id        String   @id @default(cuid())
  orgId     String
  formId    String
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  deadLetters  WebhookDeadLetter[]

  @@unique([formId, url])
  @@index([orgId])
  @@index([formId])
}

model Response {
  id          String   @id @default(cuid())
  orgId       String
  formId      String
  payload     Json
  submittedAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([formId])
  @@index([orgId, submittedAt])
}

model WebhookDeadLetter {
  id           String   @id @default(cuid())
  orgId        String
  formId       String
  webhookId    String?
  url          String
  payload      Json
  lastError    String
  attemptsMade Int
  failedAt     DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  webhook      Webhook?     @relation(fields: [webhookId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([formId])
  @@index([webhookId])
}

/// Every verified Razorpay webhook, keyed by Razorpay's event id. Razorpay
/// delivers at least once, so this is what turns a redelivery into a no-op.
model BillingEvent {
  id         String   @id
  orgId      String?
  type       String
  // applied, stale (older than state already applied) or ignored.
  outcome    String
  eventAt    DateTime
  receivedAt DateTime @default(now())

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
}
