# Copy to .env and fill in. Values shown are safe local defaults.

# --- Core (required) ---
# development | test | production. Setting "production" turns on the stricter
# JWT_SECRET checks below.
NODE_ENV=development
DATABASE_URL="postgresql://forma:forma_password@localhost:5434/forma_db?schema=public"
PORT=5001
# In production this must be at least 32 characters and must not be one of the
# placeholder values — the server refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change_me"
BCRYPT_SALT_ROUNDS=12

# --- Queues + rate limiting (required) ---
# Also backs the rate limiters, so the budget is shared across API instances.
REDIS_URL="redis://127.0.0.1:6379"

# --- Network / security ---
# Browser origins allowed to call this API, comma-separated. Defaults to
# FRONTEND_URL, then to http://localhost:3000. Set this to your real frontend
# origin in production — anything not listed is refused by the browser.
CORS_ORIGINS="http://localhost:3000"
# Number of proxy hops to trust for the client IP (usually "1" behind a load
# balancer). Leave unset when nothing sits in front of this process: trusting
# X-Forwarded-For without a proxy to overwrite it lets callers forge their IP
# and bypass rate limiting.
# TRUST_PROXY=1

# --- Billing (optional; all three or none) ---
# Leave all three unset to run without billing — the upgrade endpoints then
# return 503 and everything else works. Setting only some of them is rejected
# at boot, so the checkout cannot half-work.
RAZORPAY_KEY_ID="your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# --- Email notifications (optional) ---
# Leave RESEND_API_KEY unset to disable submission emails. The notification
# worker still drains its queue and logs a warning, so nothing else breaks.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM defaults to Resend's shared sandbox sender, which works without
# verifying a domain. Swap in your own address once a domain is verified.
EMAIL_FROM="Forma <onboarding@resend.dev>"
# Used to build links back into the app from emails.
FRONTEND_URL="http://localhost:3000"

# --- Processes ---
# The queue workers run inside the API process in development, so `npm run dev`
# is all you need. Anywhere else they are off by default: run `npm run
# start:worker` as its own process. Set this to override either default.
# RUN_WORKERS_IN_API=true

# --- Public URLs ---
# Origin this API is reachable at from outside, used to build links to uploaded
# files. Required in production; defaults to http://localhost:$PORT otherwise.
# PUBLIC_API_URL="https://forms.example.com"

# --- File storage ---
# "local" writes uploads to UPLOAD_DIR (default backend/uploads), which must be
# a persistent disk in production. "s3" works with AWS S3, Cloudflare R2 or
# MinIO, and is required once more than one API instance serves uploads.
STORAGE_DRIVER=local
# UPLOAD_DIR="/var/lib/forma/uploads"
# S3_BUCKET="forma-uploads"
# "auto" for R2.
# S3_REGION=auto
# Set for R2 or MinIO; leave unset for AWS.
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# Leave both unset to use the AWS default credential chain (e.g. an IAM role).
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# MinIO needs path-style URLs.
# S3_FORCE_PATH_STYLE=false

# --- Observability ---
# fatal | error | warn | info | debug | trace | silent. Logs are JSON lines,
# one per request plus app events.
LOG_LEVEL=info
# Errors are reported to Sentry when set.
# SENTRY_DSN=""
# Tags Sentry events with the deployed version, e.g. the git SHA. The Docker
# image sets it from the APP_RELEASE build arg.
# APP_RELEASE=""
