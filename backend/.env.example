# Copy to .env and fill in. Values shown are safe local defaults.

# --- Core (required) ---
# development | test | production. Setting "production" turns on the stricter
# JWT_SECRET checks below.
NODE_ENV=development
DATABASE_URL="postgresql://forma:forma_password@localhost:5434/forma_db?schema=public"
PORT=5001
# In production this must be at least 32 characters and must not be one of the
# placeholder values — the server refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change_me"
BCRYPT_SALT_ROUNDS=12

# --- Queues + rate limiting (required) ---
# Also backs the rate limiters, so the budget is shared across API instances.
REDIS_URL="redis://127.0.0.1:6379"

# --- Network / security ---
# Browser origins allowed to call this API, comma-separated. Defaults to
# FRONTEND_URL, then to http://localhost:3000. Set this to your real frontend
# origin in production — anything not listed is refused by the browser.
CORS_ORIGINS="http://localhost:3000"
# Number of proxy hops to trust for the client IP (usually "1" behind a load
# balancer). Leave unset when nothing sits in front of this process: trusting
# X-Forwarded-For without a proxy to overwrite it lets callers forge their IP
# and bypass rate limiting.
# TRUST_PROXY=1

# --- Billing (optional; all three or none) ---
# Leave all three unset to run without billing — the upgrade endpoints then
# return 503 and everything else works. Setting only some of them is rejected
# at boot, so the checkout cannot half-work.
RAZORPAY_KEY_ID="your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# --- Email notifications (optional) ---
# Leave RESEND_API_KEY unset to disable submission emails. The notification
# worker still drains its queue and logs a warning, so nothing else breaks.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM defaults to Resend's shared sandbox sender, which works without
# verifying a domain. Swap in your own address once a domain is verified.
EMAIL_FROM="Forma <onboarding@resend.dev>"
# Used to build links back into the app from emails.
FRONTEND_URL="http://localhost:3000"
