# Settings for docker-compose.prod.yaml. Copy to .env.production, fill in, and
# pass with --env-file. Never commit the filled-in copy.

# --- Required ---
# Public origin of the app, as users type it. The API is served from the same
# origin under /api.
PUBLIC_URL=http://localhost:8080
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Proxy ---
# ":80" for plain HTTP. A domain (forms.example.com) turns on automatic HTTPS;
# then also set HTTP_PORT=80, HTTPS_PORT=443 and PUBLIC_URL=https://<domain>.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- File storage ---
# "local" keeps uploads on a Docker volume on this host. "s3" for S3, R2 or
# MinIO — required if you run more than one API container.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Optional features ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM="Forma <forms@example.com>"
# SENTRY_DSN=
LOG_LEVEL=info
